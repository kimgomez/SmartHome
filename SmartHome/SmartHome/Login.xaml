<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartHome.Login"
               BackgroundColor="White">
    <ContentPage.Content>
        <StackLayout Padding="20" VerticalOptions="StartAndExpand" HorizontalOptions="FillAndExpand">

            <Image Source="login.png" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="240" HeightRequest="240" ></Image>
            <Entry x:Name="txtUsername" Placeholder="User" TextColor="Black" PlaceholderColor="Gray" Margin="0,100,0,0" BackgroundColor="Transparent"></Entry>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Entry x:Name="txtPassword" Grid.Column="0" Placeholder="Password" IsPassword="True" TextColor="Black" PlaceholderColor="Gray" Margin="0,10,10,10" BackgroundColor="Transparent" />
                <ImageButton x:Name="btnTogglePassword" Grid.Column="1" Source="eye_icon.png" WidthRequest="20" HeightRequest="20" BackgroundColor="Transparent" Clicked="OnTogglePasswordButtonClicked" />
            </Grid>

            <!-- Forgot Password Label -->
            <Label Text="Forgot Password?" TextColor="Gray" FontAttributes="Bold" HorizontalOptions="End" Margin="0,10,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="Binding ForgotPasswordComman}" />
                </Label.GestureRecognizers>
            </Label>
            
            <Button
                VerticalOptions="Center"
                Text="Login"
                TextColor="Black"
                BackgroundColor="Transparent"
                BorderColor="ForestGreen"
                BorderWidth="1.5"
                CornerRadius="50"
                Clicked="Button_Clicked"
                ></Button>

            <Label HorizontalOptions="Center">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Are you new? " TextColor="Gray" />
                        <Span Text="Sign Up" TextColor="Gray" FontAttributes="Bold" TextDecorations="Underline" />
                    </FormattedString>
                </Label.FormattedText>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                </Label.GestureRecognizers>
            </Label>

            <Button ImageSource="fingerprint.png"
                Text="Iniciar sesión con huella dactilar"
                 ContentLayout="Top,0"
                Clicked="OnFingerprintLoginClicked" />

        </StackLayout>
    </ContentPage.Content>
</ContentPage>