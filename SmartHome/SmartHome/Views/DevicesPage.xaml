<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartHome.Views.DevicesPage"
             Title="My Devices"
             BackgroundColor="#F5F5F5">
    <ContentPage.Content>
        <ScrollView>
            <StackLayout Padding="20">
                
                <Label Text="My Devices" 
                       FontAttributes="Bold" 
                       FontSize="24" 
                       HorizontalOptions="Center"
                       TextColor="Black"
                       Margin="0,20,0,20"/>

                <!-- Dispositivo Bombillo -->
                <Frame CornerRadius="10" 
                       BackgroundColor="White" 
                       HasShadow="True"
                       Padding="10"
                       Margin="0,10,0,10">
                    <StackLayout Orientation="Horizontal">
                        <Image x:Name="LightbulbImage" 
                               Source="OFF.png" 
                               WidthRequest="50" 
                               HeightRequest="50" 
                               VerticalOptions="Center"/>
                        <Label Text="Bombillo" 
                               VerticalOptions="Center" 
                               HorizontalOptions="StartAndExpand"
                               FontSize="18" 
                               TextColor="Black"
                               Margin="10,0"/>
                        <Button x:Name="ToggleSwitch" 
                                Text="Off" 
                                BackgroundColor="Red" 
                                TextColor="White" 
                                WidthRequest="80" 
                                VerticalOptions="Center" 
                                Clicked="OnToggleSwitchClicked"/>
                    </StackLayout>
                </Frame>

                <!-- Dispositivo Vehículo -->
                <Frame CornerRadius="10" 
                       BackgroundColor="White" 
                       HasShadow="True"
                       Padding="10"
                       Margin="0,10,0,10">
                    <StackLayout Orientation="Horizontal">
                        <Image x:Name="VehicleImage" 
                               Source="Vehicle.png" 
                               WidthRequest="50" 
                               HeightRequest="50" 
                               VerticalOptions="Center"/>
                        <Label Text="Vehículo" 
                               VerticalOptions="Center" 
                               HorizontalOptions="StartAndExpand"
                               FontSize="18" 
                               TextColor="Black"
                               Margin="10,0"/>
                        <Button x:Name="VehicleToggle" 
                                Text="Off" 
                                BackgroundColor="Red" 
                                TextColor="White" 
                                WidthRequest="80" 
                                VerticalOptions="Center" 
                                Clicked="OnVehicleToggleClicked"/>
                    </StackLayout>
                </Frame>

                <!-- Dispositivo Aire acondicionado -->
                <Frame CornerRadius="10" 
                       BackgroundColor="White" 
                       HasShadow="True"
                       Padding="10"
                       Margin="0,10,0,10">
                    <StackLayout Orientation="Horizontal">
                        <Image x:Name="AirConditionerImage" 
                               Source="AirConditioner.png" 
                               WidthRequest="50" 
                               HeightRequest="50" 
                               VerticalOptions="Center"/>
                        <Label Text="Aire acondicionado" 
                               VerticalOptions="Center" 
                               HorizontalOptions="StartAndExpand"
                               FontSize="18" 
                               TextColor="Black"
                               Margin="10,0"/>
                        <Button x:Name="AirConditionerToggle" 
                                Text="Off" 
                                BackgroundColor="Red" 
                                TextColor="White" 
                                WidthRequest="80" 
                                VerticalOptions="Center" 
                                Clicked="OnAirConditionerToggleClicked"/>
                    </StackLayout>
                </Frame>

                <!-- Dispositivo Cámara -->
                <Frame CornerRadius="10" 
                       BackgroundColor="White" 
                       HasShadow="True"
                       Padding="10"
                       Margin="0,10,0,10">
                    <StackLayout Orientation="Horizontal">
                        <Image x:Name="CameraImage" 
                               Source="Camera.png" 
                               WidthRequest="50" 
                               HeightRequest="50" 
                               VerticalOptions="Center"/>
                        <Label Text="Cámara" 
                               VerticalOptions="Center" 
                               HorizontalOptions="StartAndExpand"
                               FontSize="18" 
                               TextColor="Black"
                               Margin="10,0"/>
                        <Button x:Name="CameraToggle" 
                                Text="Off" 
                                BackgroundColor="Red" 
                                TextColor="White" 
                                WidthRequest="80" 
                                VerticalOptions="Center" 
                                Clicked="OnCameraToggleClicked"/>
                    </StackLayout>
                </Frame>

                <!-- Dispositivo Aspiradora -->
                <Frame CornerRadius="10" 
                       BackgroundColor="White" 
                       HasShadow="True"
                       Padding="10"
                       Margin="0,10,0,10">
                    <StackLayout Orientation="Horizontal">
                        <Image x:Name="VacuumImage" 
                               Source="Vacuum.png" 
                               WidthRequest="50" 
                               HeightRequest="50" 
                               VerticalOptions="Center"/>
                        <Label Text="Aspiradora" 
                               VerticalOptions="Center" 
                               HorizontalOptions="StartAndExpand"
                               FontSize="18" 
                               TextColor="Black"
                               Margin="10,0"/>
                        <Button x:Name="VacuumToggle" 
                                Text="Off" 
                                BackgroundColor="Red" 
                                TextColor="White" 
                                WidthRequest="80" 
                                VerticalOptions="Center" 
                                Clicked="OnVacuumToggleClicked"/>
                    </StackLayout>
                </Frame>

                <!-- Dispositivo Bomba de agua -->
                <Frame CornerRadius="10" 
                       BackgroundColor="White" 
                       HasShadow="True"
                       Padding="10"
                       Margin="0,10,0,10">
                    <StackLayout Orientation="Horizontal">
                        <Image x:Name="WaterPumpImage" 
                               Source="WaterPump.png" 
                               WidthRequest="50" 
                               HeightRequest="50" 
                               VerticalOptions="Center"/>
                        <Label Text="Bomba de agua" 
                               VerticalOptions="Center" 
                               HorizontalOptions="StartAndExpand"
                               FontSize="18" 
                               TextColor="Black"
                               Margin="10,0"/>
                        <Button x:Name="WaterPumpToggle" 
                                Text="Off" 
                                BackgroundColor="Red" 
                                TextColor="White" 
                                WidthRequest="80" 
                                VerticalOptions="Center" 
                                Clicked="OnWaterPumpToggleClicked"/>
                    </StackLayout>
                </Frame>

            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
